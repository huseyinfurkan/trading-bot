# Trading Bot Environment Variables
# Copy this to .env and fill with your actual values

# Exchange API Keys
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_SANDBOX=true

BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
BYBIT_SANDBOX=true

OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SANDBOX=true

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

DISCORD_WEBHOOK_URL=your_discord_webhook_url

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=notifications@yourdomain.com

# Database
DATABASE_URL=sqlite:///data/trading_bot.db

# Risk Management
MAX_PORTFOLIO_RISK=0.02
MAX_DAILY_LOSS=0.05
MAX_OPEN_POSITIONS=10

# AI Settings
AI_CONFIDENCE_THRESHOLD=0.75
AI_RETRAIN_FREQUENCY_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# Trading Mode
TRADING_MODE=test  # test or live