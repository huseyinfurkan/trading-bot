# ADVANCED TRADING BOT - ENVIRONMENT VARIABLES
# Bu dosyayı .env olarak kopyalayın ve gerçek değerlerinizi girin

# =============================================================================
# BYBIT EXCHANGE (PRIMARY)
# =============================================================================
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_SANDBOX=true  # Paper trading için true, live trading için false
BYBIT_DEFAULT_TYPE=spot  # spot, future, option

# =============================================================================
# ADDITIONAL EXCHANGES (OPTIONAL)
# =============================================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_SANDBOX=true

OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_SANDBOX=true

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Email
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///data/trading_bot.db
DATABASE_POOL_SIZE=20
DATABASE_ECHO=false

# =============================================================================
# RISK MANAGEMENT
# =============================================================================
MAX_PORTFOLIO_RISK=0.02  # 2% maximum portfolio risk
MAX_POSITION_RISK=0.005  # 0.5% maximum position risk
MAX_DAILY_LOSS=0.05      # 5% maximum daily loss
MAX_OPEN_POSITIONS=10    # Maximum number of open positions
CORRELATION_THRESHOLD=0.7 # Maximum correlation between positions

# Kelly Criterion
KELLY_ENABLED=true
KELLY_WIN_RATE=0.55      # Historical win rate (55%)
KELLY_REWARD_RISK=1.5    # Average reward/risk ratio

# =============================================================================
# AI & MACHINE LEARNING
# =============================================================================
AI_ENABLED=true
ML_MODEL_RETRAIN_DAYS=7   # Retrain models every 7 days
CONFIDENCE_THRESHOLD=0.7  # Minimum confidence for trades
SIGNAL_STRENGTH_MIN=0.65  # Minimum signal strength

# =============================================================================
# TRADING SETTINGS
# =============================================================================
TRADING_MODE=paper  # paper, live
INITIAL_CAPITAL=10000  # Starting capital for paper trading
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,ADAUSDT,BNBUSDT  # Comma-separated
DEFAULT_TIMEFRAME=1h

# Strategy weights
STRATEGY_SCALPING_WEIGHT=0.25
STRATEGY_SWING_WEIGHT=0.35
STRATEGY_TREND_WEIGHT=0.25
STRATEGY_MEAN_REVERSION_WEIGHT=0.15

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_PATH=logs/trading_bot.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Performance monitoring
CPU_THRESHOLD=80    # CPU usage warning threshold (%)
MEMORY_THRESHOLD=80 # Memory usage warning threshold (%)
DISK_THRESHOLD=90   # Disk usage warning threshold (%)

# =============================================================================
# LIVE DATA & WEBSOCKETS
# =============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_TIMEOUT=30
DATA_UPDATE_INTERVAL=10  # seconds
ANALYSIS_INTERVAL=60     # seconds
DECISION_COOLDOWN=300    # seconds (5 minutes)

# =============================================================================
# BACKTESTING
# =============================================================================
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_COMMISSION=0.001  # 0.1% commission
BACKTEST_DATA_PERIOD=180   # days of historical data

# =============================================================================
# SECURITY
# =============================================================================
# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# API rate limiting
API_REQUESTS_PER_SECOND=10
API_TIMEOUT=30

# =============================================================================
# DEVELOPMENT & DEBUG
# =============================================================================
DEBUG_MODE=false
VERBOSE_LOGGING=false
SAVE_MARKET_DATA=true   # Save market data for analysis
SIMULATION_MODE=false   # Use simulated data instead of real API calls